# Copy this file to .env and use your own service settings.
# Required at application startup. A placeholder does not enable real AI access.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Optional for startup; required for real outgoing email.
SENDER_EMAIL=your-address@example.com
SENDER_PASSWORD=YOUR_EMAIL_APP_PASSWORD
# Optional: key for signing login tokens. If empty, backend/.secret_key is created automatically.
SECRET_KEY=
# Optional: replaces the default admin password at every start. Set this before any demo.
ADMIN_PASSWORD=
# Optional: set to 1 only on your own computer for Flask debug mode.
FLASK_DEBUG=0
# Limits (optional). How many times one person may start the test per hour:
MAX_TESTS_PER_HOUR=5
# Minimum seconds between AI question generations for the whole server (cost control):
AI_GENERATION_COOLDOWN=60
